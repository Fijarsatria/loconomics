# Salin jadi ".env" lalu isi. Jangan commit ".env".
#
# TIDAK ADA kunci MAPID di sini, dan jangan pernah menambahkannya kembali.
# Setiap variabel VITE_ ikut ter-bundel ke dist/assets/*.js yang dilayani
# publik. Kunci basemap MAPID hidup di backend/.env sebagai MAPID_MAPS_API_KEY,
# dan gayanya diambil lewat GET {VITE_API_BASE_URL}/meta/basemap/{gaya}/style.json.
VITE_API_BASE_URL=http://localhost:8000
