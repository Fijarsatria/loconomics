# Salin file ini jadi ".env" lalu isi nilai aslinya. Jangan pernah commit ".env".

# Supabase Postgres — pakai connection string mode "Transaction pooler"
DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# MAPID MAPS basemap API key — didapat dari Irvan / panitia.
# Ini satu-satunya kunci di berkas ini yang juga boleh ada di frontend/.env:
# menurut briefing MAPID, kunci basemap hanya menghitung pemakaian.
MAPID_MAPS_API_KEY=

# Akses data misi MAPID (Properti Go / Struk Go / Menu Go) lewat header x-api-key.
# BACKEND SAJA. Jangan pernah diteruskan ke frontend.
MAPID_DATA_API_KEY=

# --- AI Consultant ---------------------------------------------------------
# BACKEND SAJA. Seluruh variabel VITE_ ikut ter-bundel ke berkas yang bisa
# dibuka siapa saja, jadi kunci ini tidak boleh menyentuh frontend dalam bentuk
# apa pun. Kalau frontend butuh hasilnya, backend yang memanggil dan meneruskan.
#
# Kosongkan kalau belum ada kuncinya: seluruh endpoint lain tetap jalan, dan
# POST /ai/tanya mengembalikan 501 dengan pesan yang menjelaskan apa yang kurang.
# Cek kesiapannya lewat GET /ai/status.
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
