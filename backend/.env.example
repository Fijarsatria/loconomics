# Salin file ini jadi ".env" lalu isi nilai aslinya. Jangan pernah commit ".env".

# Supabase Postgres — pakai connection string mode "Transaction pooler"
DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# MAPID MAPS basemap API key — didapat dari Irvan / panitia
MAPID_MAPS_API_KEY=

# LLM provider buat AI Consultant (isi sesuai provider yang dipakai Ukas)
LLM_API_KEY=
