# Salin file ini jadi ".env" lalu isi nilai aslinya. Jangan pernah commit ".env".

# Supabase Postgres — pakai connection string mode "Transaction pooler"
DATABASE_URL=postgresql+psycopg://postgres.xxxxxxxxxxxx:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# MAPID MAPS basemap API key — didapat dari Irvan / panitia.
# Ini satu-satunya kunci di berkas ini yang juga boleh ada di frontend/.env:
# menurut briefing MAPID, kunci basemap hanya menghitung pemakaian.
MAPID_MAPS_API_KEY=

# Akses data misi MAPID (Properti Go / Struk Go / Menu Go) lewat header x-api-key.
# BACKEND SAJA. Jangan pernah diteruskan ke frontend.
MAPID_DATA_API_KEY=

# --- AI Consultant ---------------------------------------------------------
# BACKEND SAJA. Seluruh variabel VITE_ ikut ter-bundel ke berkas yang bisa
# dibuka siapa saja, jadi kunci ini tidak boleh menyentuh frontend dalam bentuk
# apa pun. Kalau frontend butuh hasilnya, backend yang memanggil dan meneruskan.
#
# Kosongkan kalau belum ada kuncinya: seluruh endpoint lain tetap jalan, dan
# POST /ai/tanya mengembalikan 501 dengan pesan yang menjelaskan apa yang kurang.
# Cek kesiapannya lewat GET /ai/status.
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5

# Plafon biaya AI per hari, dalam USD. Dihitung dari ai_call_logs.
# Permintaan ditolak dengan 429 setelah plafon tercapai. Naikkan kalau memang
# perlu, tetapi jangan dikosongkan - satu useEffect yang salah di frontend sudah
# cukup untuk memanggil /ai/tanya berulang kali tanpa ada yang menyadarinya.
LLM_PLAFON_HARIAN_USD=2.0

# --- Routing jalan kaki (OpenRouteService) ---------------------------------
# Dipakai pipeline/rute_ors.py untuk menghitung rute jalan kaki dari tiap
# heksagon ke simpul transportasi terdekat, lalu menyimpannya ke tabel
# hex_routes. Backend TIDAK pernah memanggil ORS saat melayani permintaan.
#
# BACKEND SAJA. Kuota gratisnya 2.000 permintaan per hari untuk seluruh akun,
# jadi kunci yang ikut ter-bundel ke frontend bisa dihabiskan siapa saja.
#
# Daftar gratis di https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# --- Akun dan langganan ----------------------------------------------------
# Kunci penandatangan tiket sesi. BACKEND SAJA - siapa pun yang memilikinya bisa
# menempa tiket untuk akun mana pun, termasuk akun pemilik.
#
# Boleh dikosongkan di pengembangan: app/core/akun.py menurunkan kunci sementara
# dari DATABASE_URL, stabil antar-restart supaya sesi tidak hangus tiap reload.
# Di produksi ia WAJIB diisi - tanpa itu backend menolak jalan.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# --- Deployment ------------------------------------------------------------
# Isi "produksi" saat deploy. Efeknya: /docs dan /redoc disembunyikan.
LINGKUNGAN=pengembangan

# Daftar dipisah koma. Saat deploy, isi dengan domain frontend yang sebenarnya.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:4173"]

# Sandi akun pemilik yang dibuat seed_akun.py. Tanpa ini skrip itu berhenti,
# dan itu disengaja - skrip pembuat akun admin tidak boleh punya sandi bawaan.
SEED_AKUN_SANDI=
