# Arsip. Sebuah .zip berisi backend/.env pernah nyaris ter-push (29 Agu 2026):
# 380 MB, 25.850 berkas, termasuk SELURUH kunci API dan kredensial Supabase.
# Pemeriksaan rahasia yang mencari string kunci di dalam diff TIDAK menangkapnya
# karena isinya terkompresi - yang terlihat cuma nama berkasnya.
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Rahasia — jangan pernah di-commit
.env
.env.local
*.env
!.env.example

# Data MAPID / mitra — tidak boleh diredistribusi (ketentuan lomba B.7)
pipeline/data/

# Python
**/venv/
**/.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
**/node_modules/.vite/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json

# Dokumen panitia MAPID - milik penyelenggara, tidak perlu ikut diredistribusi
Technical Meeting*.pdf

